NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGO_URI=mongodb://localhost:27017/ets
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:5000
UPLOAD_DIR=uploads
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
FRONTEND_BASE_URL=http://localhost:5173
# 32+ char random string used to encrypt Stripe keys stored in MongoDB
SETTINGS_ENCRYPTION_KEY=change-me-to-a-random-32-plus-character-string

# SMS OTP — MSG91 / white-label panel (requires DLT registration, e.g. Jio TrueConnect)
# MSG91_BASE_URL: API base of the panel (e.g. https://control.msg91.com or https://control.sms91.in).
# MSG91_TEMPLATE_ID is the panel's template id (not the DLT template id); the template
# text must match the DLT-approved one and use ##number## as the variable.
MSG91_BASE_URL=https://control.msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
